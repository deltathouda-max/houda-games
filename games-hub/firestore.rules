rules_version = '2';

// 友達内で合言葉(部屋コード)を共有して遊ぶカジュアルなパーティーゲーム向けの簡易ルール。
// 匿名認証済みであれば部屋の状態を更新できる(ホスト権限のチェックはアプリ側のUIで行う)。
// 各プレイヤーの参加者ドキュメントは本人(uid)のみが作成・更新・削除できる。
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;

      match /players/{playerId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == playerId;
      }

      // 一瞬表示して消える軽量なリアクション。送った本人だけが作成・削除できる
      // (削除は送信側が表示後に自分で片付けるクライアント実装。溜まり続けない設計)
      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.playerId
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() <= 8;
        allow delete: if request.auth != null && request.auth.uid == resource.data.playerId;
        allow update: if false;
      }
    }
  }
}
